# 复制为 .env 后填写。不要把真实密钥提交到仓库。
# 页面「模型设置」里填写的密钥只存在浏览器 localStorage，优先级高于这里。
# 留空时，本地开发服务器会使用这些环境变量，浏览器看不到密钥本身。

# 文案：DeepSeek（OpenAI Chat Completions 兼容）
# 申请：https://platform.deepseek.com/api_keys
# 文档：https://api-docs.deepseek.com/
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 文案：其他 OpenAI 兼容接口。模型 ID 以厂商当前文档为准。
# 千问兼容模式示例：https://dashscope.aliyuncs.com/compatible-mode/v1
# Kimi 示例：https://api.moonshot.cn/v1
OPENAI_COMPAT_TEXT_API_KEY=
OPENAI_COMPAT_TEXT_MODEL=
OPENAI_COMPAT_TEXT_BASE_URL=

# 配图：火山方舟豆包 Seedream
# 申请：https://ark.volcengine.com/region:cn-beijing/apikey
# 文档：https://ark.volcengine.com/region:cn-beijing/docs/image-generation-api
# 默认模型为 Seedream 5.5。调用前需在方舟开通对应模型。
ARK_API_KEY=
ARK_MODEL=doubao-seedream-5-5-261028
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 配图：其他 OpenAI Images 兼容接口，路径为 {BASE}/images/generations
OPENAI_COMPAT_IMAGE_API_KEY=
OPENAI_COMPAT_IMAGE_MODEL=
OPENAI_COMPAT_IMAGE_BASE_URL=

# 热点：自定义搜索接口。不填也可以，页面里默认可拉百度热搜。
# 本应用请求 GET {HOT_SEARCH_URL}?q=关键词
# 推荐返回 { "items": [{ "title": "话题", "heat": "123", "url": "https://..." }] }
# 若设置了密钥，会放在 Authorization: Bearer 里，不会写进查询字符串。
HOT_SEARCH_URL=
HOT_SEARCH_API_KEY=
